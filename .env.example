# Copy to .env. Never commit real credentials.
PP_BACKEND=local
PP_DATA_DIR=data
SEC_USER_AGENT=PolicyPilot YourName your-email@example.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Calibrate with labeled retrieval examples; similarity is not confidence.
PP_MIN_SCORE=0.30
# Databricks backend uses SDK unified authentication, not GROQ_API_KEY.
DATABRICKS_HOST=
PP_VECTOR_ENDPOINT=policypilot-search
PP_VECTOR_INDEX=policypilot_dev.filings.chunks_index
PP_MODEL_SERVICE=policypilot_dev.filings.research_model
